<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    tools:context=".HistoryActivity">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:background="@color/paper"
      android:orientation="vertical"
      android:paddingStart="16dp"
      android:paddingEnd="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="12dp">

      <ImageButton
          android:id="@+id/back"
          android:layout_width="44dp"
          android:layout_height="44dp"
          android:background="@drawable/bg_pill"
          android:contentDescription="@string/back"
          android:scaleType="center"
          android:src="@drawable/ic_back" />

      <TextView
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:layout_marginStart="10dp"
          android:fontFamily="sans-serif-medium"
          android:text="@string/history_title"
          android:textColor="@color/ink"
          android:textSize="20sp"
          android:textStyle="bold"
          android:letterSpacing="-0.02" />
    </LinearLayout>

    <!-- Tabs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="10dp">

      <TextView
          android:id="@+id/tabFine"
          android:layout_width="0dp"
          android:layout_height="36dp"
          android:layout_weight="1"
          android:layout_marginEnd="8dp"
          android:background="@drawable/bg_tab_selected"
          android:gravity="center"
          android:text="@string/tab_fine"
          android:textColor="@color/surface"
          android:textSize="13sp"
          android:textStyle="bold"
          android:fontFamily="sans-serif-medium" />

      <TextView
          android:id="@+id/tabTejabi"
          android:layout_width="0dp"
          android:layout_height="36dp"
          android:layout_weight="1"
          android:layout_marginEnd="8dp"
          android:background="@drawable/bg_tab"
          android:gravity="center"
          android:text="@string/tab_tejabi"
          android:textColor="@color/ink"
          android:textSize="13sp"
          android:fontFamily="sans-serif-medium" />

      <TextView
          android:id="@+id/tabSilver"
          android:layout_width="0dp"
          android:layout_height="36dp"
          android:layout_weight="1"
          android:background="@drawable/bg_tab"
          android:gravity="center"
          android:text="@string/tab_silver"
          android:textColor="@color/ink"
          android:textSize="13sp"
          android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <TextView
        android:id="@+id/subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="4dp"
        android:fontFamily="sans-serif"
        android:textColor="@color/muted"
        android:textSize="12sp"
        tools:text="Tap or drag to inspect" />

    <!-- Chart card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="4dp">

      <np.goldmandu.app.ui.SparklineView
          android:id="@+id/spark"
          android:layout_width="match_parent"
          android:layout_height="match_parent" />
    </LinearLayout>

    <!-- Inspector card -->
    <LinearLayout
        android:id="@+id/inspect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

      <TextView
          android:id="@+id/selDate"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:textColor="@color/accent"
          android:textSize="13sp"
          android:textStyle="bold"
          android:fontFamily="sans-serif-medium"
          tools:text="1 Ashoj 2083" />

      <TextView
          android:id="@+id/selFineDelta"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="2dp"
          android:textSize="12sp"
          android:textStyle="bold"
          android:fontFamily="sans-serif-medium"
          tools:text="↓ −2,300 (0.76%)" />

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/fine_gold"
            android:textColor="@color/muted"
            android:textSize="12sp"
            android:fontFamily="sans-serif" />

        <TextView
            android:id="@+id/selFine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/ink"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            tools:text="Rs. 2,99,500 /tola" />
      </LinearLayout>

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="4dp"
          android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tejabi_gold"
            android:textColor="@color/muted"
            android:textSize="12sp"
            android:fontFamily="sans-serif" />

        <TextView
            android:id="@+id/selTejabi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/ink"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            tools:text="Rs. 2,84,525 /tola" />
      </LinearLayout>

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="4dp"
          android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/silver"
            android:textColor="@color/muted"
            android:textSize="12sp"
            android:fontFamily="sans-serif" />

        <TextView
            android:id="@+id/selSilver"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/ink"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            tools:text="Rs. 4,625 /tola" />
      </LinearLayout>
    </LinearLayout>

    <!-- Stats -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_card"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

      <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/low"
            android:textColor="@color/muted"
            android:textSize="11sp"
            android:fontFamily="sans-serif" />

        <TextView
            android:id="@+id/statLow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/ink"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            tools:text="Rs. 2,73,900" />
      </LinearLayout>

      <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:gravity="center"
          android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/now"
            android:textColor="@color/muted"
            android:textSize="11sp"
            android:fontFamily="sans-serif" />

        <TextView
            android:id="@+id/statNow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/ink"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            tools:text="Rs. 2,99,500" />
      </LinearLayout>

      <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:gravity="end"
          android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/high"
            android:textColor="@color/muted"
            android:textSize="11sp"
            android:fontFamily="sans-serif" />

        <TextView
            android:id="@+id/statHigh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/ink"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            tools:text="Rs. 3,28,600" />
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
